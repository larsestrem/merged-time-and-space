{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concept pages",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "slug",
      "question",
      "term",
      "shortAnswer",
      "title",
      "description",
      "cluster",
      "hubUrls",
      "relatedSlugs",
      "graphicId",
      "graphicCaption",
      "graphicAlt",
      "sections",
      "seeItLive"
    ],
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^(what-is|what-are|why-|how-does|how-are).+"
      },
      "question": { "type": "string" },
      "term": { "type": "string" },
      "shortAnswer": { "type": "string", "maxLength": 520 },
      "ledeHtml": {
        "type": "string",
        "description": "Optional intro HTML for the concept page only. Teasers, glossary and JSON-LD keep using the plain shortAnswer. Tokens {tilt}, {juneSolstice}, {decSolstice} are filled at build."
      },
      "title": { "type": "string" },
      "description": { "type": "string", "maxLength": 170 },
      "cluster": { "enum": ["day-night", "questions", "simulator", "solar", "time"] },
      "hubUrls": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["href", "label"],
          "properties": {
            "href": { "type": "string" },
            "label": { "type": "string" }
          }
        }
      },
      "relatedSlugs": { "type": "array", "items": { "type": "string" } },
      "graphicId": {
        "enum": [
          "sun-earth-line",
          "day-night-map",
          "orbit",
          "orbit-live",
          "moon-phase",
          "tides",
          "jupiter",
          "globe",
          "olbers",
          "season-orbit",
          "system-orbit",
          "none"
        ]
      },
      "graphicPlanet": {
        "type": "string",
        "description": "Planet name for graphicId globe, matching globe.mjs (Mars, Jupiter, …)."
      },
      "graphicCaption": { "type": "string" },
      "graphicAlt": { "type": "string" },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["heading", "band", "body"],
          "properties": {
            "heading": { "type": "string" },
            "band": { "enum": ["5-12", "deeper"] },
            "body": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "seeItLive": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["href", "label"],
          "properties": {
            "href": { "type": "string" },
            "label": { "type": "string" }
          }
        }
      }
    }
  }
}
